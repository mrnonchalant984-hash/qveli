# Supabase Storage / S3-compatible object storage (preferred for Qevli production)
S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="qevli-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CDN_BASE_URL=""

# V31 multi-region / deployment identity
QEVLI_REGION="local"
QEVLI_PRIMARY_REGION="local"
QEVLI_READ_REGIONS=""
QEVLI_EVENT_STREAM="qevli:events"

# Optional observability
QEVLI_LOG_LEVEL="info"
QEVLI_TRACE_ENABLED="false"

# Separate local/prod admin gateway
QEVLI_ADMIN_PORT="3001"
QEVLI_ADMIN_URL="http://localhost:3001"

# V37 storage: Supabase is the production object store. Local mode remains available for development.
QEVLI_STORAGE_MODE=supabase

