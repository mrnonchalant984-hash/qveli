DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/qevli"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email via Resend
RESEND_API_KEY=""
EMAIL_FROM="Qevli <noreply@your-verified-domain.com>"

# Real-time phone OTP via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional web search
BRAVE_SEARCH_API_KEY=""
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""

# Monnify sandbox billing
QEVLI_MONETIZATION_ENABLED="true"
MONNIFY_BASE_URL="https://sandbox.monnify.com/api/v1"
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WEBHOOK_SECRET=""
MONNIFY_REDIRECT_URL="http://localhost:3000/settings?billing=complete"
MONNIFY_PAYMENT_METHODS="CARD,ACCOUNT_TRANSFER,USSD"
MONNIFY_TIMEOUT_MS="15000"
QEVLI_EMAIL_ENABLED="true"
QEVLI_PUSH_ENABLED="false"

# V31 Redis: REST client for Next.js cache/rate-limit/realtime work
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# V31 Redis protocol URL for BullMQ workers/background jobs
# Example format: rediss://default:PASSWORD@YOUR-DATABASE.upstash.io:6379
REDIS_URL=""

# V31 object storage / CDN (Cloudflare R2 is recommended)
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="qevli-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
CDN_BASE_URL="https://cdn.qevli.com"

# V31 multi-region / deployment identity
QEVLI_REGION="local"
QEVLI_PRIMARY_REGION="local"
QEVLI_READ_REGIONS=""
QEVLI_EVENT_STREAM="qevli:events"

# Optional observability
QEVLI_LOG_LEVEL="info"
QEVLI_TRACE_ENABLED="false"

# Separate local/prod admin gateway
QEVLI_ADMIN_PORT="3001"
QEVLI_ADMIN_URL="http://localhost:3001"

# V37 storage: local requires no R2/card. Set external only when production S3/R2 is configured.
QEVLI_STORAGE_MODE=local

# Optional secret to protect official feed sync endpoint and cron
QEVLI_CRON_SECRET=""
