generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}
enum VerificationChannel {
  EMAIL
  PHONE
}
enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}
enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  MENTION
  SYSTEM
}
enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  NUDITY
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum OnboardingSource {
  SCHOOL
  FRIEND
  GOOGLE
  TIKTOK
  INSTAGRAM
  TWITTER
  AI
  OTHER
}

enum FeatureRequestCategory {
  BUG
  FEATURE
  IMPROVEMENT
}

enum FeatureRequestStatus {
  REQUESTED
  PLANNED
  IN_PROGRESS
  DONE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  name          String
  bio           String   @default("")
  school        String?
  schoolUrl     String?
  workplace     String?
  workplaceUrl  String?
  jobTitle      String?
  currentCity   String?
  hometown      String?
  website       String?
  education     String?
  interests     String?
  avatarUrl     String?
  coverUrl      String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime?
  emailVerifiedAt DateTime?
  phoneNumber String? @unique
  phoneVerifiedAt DateTime?
  dateOfBirth DateTime?
  gender String?
  verificationRequired Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  professionalMode Boolean @default(false)
  verified      Boolean @default(false)
  verifiedAt    DateTime?
  profileBoostedUntil DateTime?
  coinBalance  Int @default(0)
  walletBonusAwardedAt DateTime?

  posts         Post[]
  companyFollows CompanyFollow[]
  comments      Comment[]
  reposts       Repost[] @relation("repostAuthor")
  shares        PostShare[]
  reactions     PostReaction[]
  stories       Story[]
  storyViews    StoryView[]
  sentMessages  Message[] @relation("sentMessages")
  notifications Notification[] @relation("notificationRecipient")
  otpCodes VerificationCode[]
  adminAuthCodes AdminAuthCode[]
  actorNotifications Notification[] @relation("notificationActor")
  following     Follow[] @relation("following")
  followers     Follow[] @relation("followers")
  friendRequestsSent Friendship[] @relation("friendRequestsSent")
  friendRequestsReceived Friendship[] @relation("friendRequestsReceived")
  platformRecords PlatformRecord[] @relation("platformRecords")
  blocksMade    Block[] @relation("blocksMade")
  blocksReceived Block[] @relation("blocksReceived")
  reportsMade   Report[] @relation("reportsMade")
  officialReactions OfficialFeedReaction[]
  officialComments OfficialFeedComment[]
  officialShares OfficialFeedShare[]
  reportsAgainst Report[] @relation("reportsAgainst")
  memberships   ConversationMember[]
  groupsOwned Group[] @relation("groupOwner")
  groupMemberships GroupMember[]
  groupMessages GroupMessage[]
  callsMade CallSession[] @relation("callsMade")
  callsReceived CallSession[] @relation("callsReceived")
  liveStreams LiveStream[]
  emailTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions UserSession[]
  securityEvents SecurityEvent[]
  notificationPreferences NotificationPreference?
  pushSubscriptions PushSubscription[]
  mediaAssets MediaAsset[]
  analyticsEvents AnalyticsEvent[]
  moderationCases ModerationCase[] @relation("moderationReporter")
  moderationAgainst ModerationCase[] @relation("moderationTarget")
  appeals Appeal[]
  recommendationFeedback RecommendationFeedback[]
  feedActivities FeedActivity[]
  subscriptions Subscription[]
  paymentRecords PaymentRecord[]
  profileBoostsRequested ProfileBoost[] @relation("profileBoostRequester")
  profileBoostsTargeted ProfileBoost[] @relation("profileBoostTarget")
  eventsOwned Event[] @relation("eventOwner")
  eventAttendances EventAttendee[]
  marketplaceListings MarketplaceListing[]
  gamingTeamsOwned GamingTeam[] @relation("gamingTeamOwner")
  gamingTeamMemberships GamingTeamMember[]
  tournamentsOwned Tournament[] @relation("tournamentOwner")
  tournamentRegistrations TournamentRegistration[]
  tournamentMatchesA TournamentMatch[] @relation("matchPlayerA")
  tournamentMatchesB TournamentMatch[] @relation("matchPlayerB")
  savedItems SavedItem[]
  memories Memory[]
  onboardingSurveys OnboardingSurvey[]
  featureRequests FeatureRequest[]
  featureVotes FeatureRequestVote[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
}

model Post {
  id          String @id @default(cuid())
  authorId    String
  text        String @db.Text
  imageUrl    String?
  mediaUrl    String?
  mediaType   String?
  visibility  String @default("PUBLIC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   PostReaction[]
  comments    Comment[]
  reports     Report[]
  shares      PostShare[]
  reposts    Repost[] @relation("originalPost")
  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostReaction {
  id        String       @id @default(cuid())
  postId   String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@index([postId, type])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id        String @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  text      String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("commentReplies")
  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model Repost {
  id             String   @id @default(cuid())
  postId         String
  authorId       String
  text           String   @default("") @db.Text
  createdAt      DateTime @default(now())
  post           Post     @relation("originalPost", fields: [postId], references: [id], onDelete: Cascade)
  author         User     @relation("repostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([postId, authorId])
  @@index([createdAt])
}

model Story {
  id        String @id @default(cuid())
  authorId  String
  text      String @db.Text
  mediaUrl  String?
  mediaType String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]
  @@index([expiresAt])
}

model StoryView {
  id       String @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  @@unique([storyId, viewerId])
}

model Conversation {
  id        String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  text           String @db.Text
  imageUrl       String?
  mediaType      String?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  recipient   User @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User? @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([recipientId, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String?
  postId     String?
  reason     ReportReason
  details    String       @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reporter   User @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User? @relation("reportsAgainst", fields: [reportedId], references: [id], onDelete: SetNull)
  post       Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}


model OfficialFeedSource {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  handle                String?
  feedUrl               String
  websiteUrl            String
  logoUrl               String?
  category              String   @default("NEWS")
  country               String?
  language              String   @default("en")
  sourceType            String   @default("RSS")
  trustLevel            String   @default("VERIFIED")
  enabled               Boolean  @default(true)
  syncIntervalMinutes   Int      @default(30)
  lastSyncedAt          DateTime?
  lastSuccessAt         DateTime?
  lastError             String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  items                 OfficialFeedItem[]
  @@index([enabled, category])
  @@index([lastSyncedAt])
}

model OfficialFeedItem {
  id          String   @id @default(cuid())
  sourceId    String?
  externalId  String?
  sourceName  String
  sourceHandle String?
  sourceUrl   String
  logoUrl     String?
  title       String
  body        String   @db.Text
  mediaUrl    String?
  mediaType   String?
  category    String   @default("NEWS")
  publishedAt DateTime
  createdAt   DateTime @default(now())
  source      OfficialFeedSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  @@unique([sourceId, externalId])
  @@index([publishedAt])
  @@index([category, publishedAt])
  reactions   OfficialFeedReaction[]
  comments    OfficialFeedComment[]
  shares      OfficialFeedShare[]
}

model OfficialFeedReaction {
  id        String       @id @default(cuid())
  itemId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  item      OfficialFeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([itemId, userId])
  @@index([itemId, type])
}

model OfficialFeedComment {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())
  item      OfficialFeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}

model OfficialFeedShare {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())
  item      OfficialFeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([itemId, userId])
  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  category    String
  logoUrl     String?
  createdAt   DateTime @default(now())
  followers   CompanyFollow[]
  updates     CompanyUpdate[]
}

model CompanyUpdate {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  body        String   @db.Text
  mediaUrl    String?
  mediaType   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sourceName  String?
  sourceUrl   String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
}

model CompanyFollow {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}


model Group {
  id          String   @id @default(cuid())
  name        String
  description String   @default("") @db.Text
  coverUrl    String?
  privacy     String   @default("PUBLIC")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("groupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]
  @@index([ownerId, createdAt])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id          String   @id @default(cuid())
  groupId     String
  senderId    String
  text        String   @db.Text
  mediaUrl    String?
  mediaType   String?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([groupId, createdAt])
}

model CallSession {
  id          String   @id @default(cuid())
  callerId    String
  calleeId    String
  kind        String   @default("VIDEO")
  status      String   @default("RINGING")
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  caller      User     @relation("callsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee      User     @relation("callsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
}

model LiveStream {
  id          String   @id @default(cuid())
  hostId      String
  title       String
  description String   @default("") @db.Text
  status      String   @default("SCHEDULED")
  viewerCount Int      @default(0)
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([hostId, createdAt])
}

model Friendship {
  id         String   @id @default(cuid())
  requesterId String
  addresseeId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  requester  User @relation("friendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee  User @relation("friendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Event {
  id          String @id @default(cuid())
  ownerId     String
  title       String
  description String @db.Text
  date        DateTime
  location    String?
  category    String?
  status      String @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("eventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]
  @@index([date])
  @@index([ownerId, createdAt])
}

model EventAttendee {
  id        String @id @default(cuid())
  eventId   String
  userId    String
  status    String @default("GOING")
  createdAt DateTime @default(now())
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model MarketplaceListing {
  id          String @id @default(cuid())
  sellerId    String
  title       String
  description String @db.Text
  price       Int
  location    String?
  category    String?
  condition   String?
  imageUrl    String?
  status      String @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model GamingTeam {
  id          String @id @default(cuid())
  ownerId     String
  name        String
  description String @db.Text
  game        String
  region      String?
  lookingFor  String?
  status      String @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("gamingTeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GamingTeamMember[]
  @@index([game, createdAt])
  @@index([ownerId, createdAt])
}

model GamingTeamMember {
  id        String @id @default(cuid())
  teamId    String
  userId    String
  role      String @default("MEMBER")
  createdAt DateTime @default(now())
  team      GamingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId, createdAt])
}

model Tournament {
  id          String @id @default(cuid())
  ownerId     String
  title       String
  description String @db.Text
  game        String
  startDate   DateTime
  format      String?
  maxTeams    Int?
  status      String @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("tournamentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  registrations TournamentRegistration[]
  matches     TournamentMatch[]
  @@index([game, startDate])
  @@index([ownerId, createdAt])
}

model TournamentRegistration {
  id           String @id @default(cuid())
  tournamentId String
  userId       String
  teamName     String?
  createdAt    DateTime @default(now())
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, userId])
  @@index([userId, createdAt])
}

model TournamentMatch {
  id           String @id @default(cuid())
  tournamentId String
  round        Int
  playerAId    String?
  playerBId    String?
  scoreA       Int @default(0)
  scoreB       Int @default(0)
  status       String @default("SCHEDULED")
  startsAt     DateTime?
  createdAt    DateTime @default(now())
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA     User? @relation("matchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerB     User? @relation("matchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  @@index([tournamentId, round])
}

model SavedItem {
  id         String @id @default(cuid())
  userId     String
  sourceType String
  sourceId   String
  collection String @default("General")
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceType, sourceId])
  @@index([userId, collection, createdAt])
}

model Memory {
  id          String @id @default(cuid())
  userId      String
  sourcePostId String?
  title       String
  body        String @db.Text
  memoryDate  DateTime
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, memoryDate])
}

model PlatformRecord {
  id        String   @id @default(cuid())
  type      String
  ownerId   String
  title     String
  body      String   @default("") @db.Text
  metadata  Json?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User @relation("platformRecords", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([type, createdAt])
  @@index([ownerId, type, createdAt])
}



model VerificationCode {
  id        String @id @default(cuid())
  userId    String
  channel   VerificationChannel
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int @default(0)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, channel, expiresAt])
}

model AdminAuthCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  sessionHash String  @unique
  deviceName String?
  ipHash     String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, lastSeenAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  likes     Boolean  @default(true)
  comments  Boolean  @default(true)
  follows   Boolean  @default(true)
  messages  Boolean  @default(true)
  mentions  Boolean  @default(true)
  marketing Boolean  @default(false)
  push      Boolean  @default(false)
  email     Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  ownerId     String
  url         String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  storageKey  String?
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  path       String?
  sessionId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model ModerationCase {
  id          String   @id @default(cuid())
  reporterId  String
  targetId    String?
  postId      String?
  reason      String
  details     String   @db.Text
  status      String   @default("OPEN")
  severity    String   @default("MEDIUM")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reporter    User @relation("moderationReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target      User? @relation("moderationTarget", fields: [targetId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([targetId, createdAt])
}

model Appeal {
  id         String   @id @default(cuid())
  userId     String
  caseId     String?
  message    String   @db.Text
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}


model FeedActivity {
  id           String   @id @default(cuid())
  userId       String
  targetType   String
  targetId     String
  action       String
  reactionType String?
  text         String?  @db.Text
  parentId     String?
  createdAt    DateTime @default(now())
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       FeedActivity? @relation("activityReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      FeedActivity[] @relation("activityReplies")
  @@index([targetType, targetId, createdAt])
  @@index([userId, targetType, targetId, action])
  @@index([parentId, createdAt])
}

model RecommendationFeedback {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  action     String
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @db.Text
  priceMinor  Int
  currency    String   @default("NGN")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  planId      String
  status      String   @default("DISABLED")
  provider    String?
  providerRef String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([userId, status])
}

model ProfileBoost {
  id              String    @id @default(cuid())
  targetUserId    String
  requesterUserId String?
  planCode        String?
  status          String    @default("PENDING")
  amountMinor     Int
  currency        String    @default("NGN")
  provider        String?
  providerRef     String?
  randomCode      String    @default("")
  approvedByUserId String?
  approvedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  targetUser      User      @relation("profileBoostTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requester       User?     @relation("profileBoostRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  @@index([targetUserId, status])
  @@index([status, createdAt])
}

model PaymentRecord {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  amountMinor Int
  currency    String   @default("NGN")
  status      String   @default("DISABLED")
  provider    String?
  providerRef String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdCampaign {
  id          String   @id @default(cuid())
  ownerId     String?
  name        String
  status      String   @default("DISABLED")
  budgetMinor Int      @default(0)
  currency    String   @default("NGN")
  targeting   Json?
  creative    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
  @@unique([provider, eventId])
  @@index([provider, createdAt])
}

model BackgroundJob {
  id          String   @id @default(cuid())
  queue       String
  jobName     String
  payload     Json?
  status      String   @default("QUEUED")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([queue, status, availableAt])
  @@index([status, createdAt])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  type          String
  aggregateType String?
  aggregateId   String?
  payload       Json?
  region        String   @default("local")
  publishedAt   DateTime?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([publishedAt, createdAt])
  @@index([type, createdAt])
  @@index([aggregateType, aggregateId])
}

model OnboardingSurvey {
  id        String           @id @default(cuid())
  userId    String           @unique
  source    OnboardingSource
  otherText String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([source, createdAt])
}

model FeatureRequest {
  id          String                @id @default(cuid())
  userId      String
  title       String
  description String?
  category    FeatureRequestCategory @default(FEATURE)
  status      FeatureRequestStatus   @default(REQUESTED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes       FeatureRequestVote[]
  @@index([status, createdAt])
}

model FeatureRequestVote {
  id        String         @id @default(cuid())
  requestId String
  userId    String
  createdAt DateTime       @default(now())
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([requestId, userId])
  @@index([userId, createdAt])
}
